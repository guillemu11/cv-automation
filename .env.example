# Copy to .env and fill in. NEVER commit .env.
# -----------------------------------------------------------------------------

# LLM provider — chooses the backend for scoring + CV/CL/outreach generation.
#   anthropic  → Claude API (costs $ per call). Needs ANTHROPIC_API_KEY.
#   gemini     → Google Gemini (cheap fallback). Needs GEMINI_API_KEY.
#   chatqueue  → parks each request under data/chat_queue/inbox/ and blocks
#                until a human-in-chat (Claude Code / Cowork) writes a reply
#                in data/chat_queue/outbox/. No API spend. See plan in
#                C:\Users\gmunoz02\.claude\plans\purrfect-growing-puzzle.md
LLM_PROVIDER=anthropic
CHATQUEUE_TIMEOUT_SECONDS=1800   # 30 min — how long a parked request waits before falling back to {}
CHATQUEUE_POLL_SECONDS=2.0       # how often the provider checks data/chat_queue/outbox/

# Claude API (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Image generation — Google Gemini image API ("Nano Banana"). Replaces Higgsfield.
# Used by career_ops/generators/images.py (campaign-landing stills, deck visuals).
# IMPORTANT: image models require a BILLING-ENABLED Google Cloud project — the
# free tier has a hard quota of 0 for image generation (text scoring is free).
# If GOOGLE_IMAGE_API_KEY is blank, it falls back to GEMINI_API_KEY.
GEMINI_API_KEY=                # Gemini API key (text scoring + image fallback)
GOOGLE_IMAGE_API_KEY=          # dedicated image key; needs billing. Get at https://aistudio.google.com/apikey
IMAGE_MODEL=gemini-3-pro-image # or gemini-2.5-flash-image (cheaper/faster)

# Notion (required)
NOTION_TOKEN=secret_...
NOTION_DB_JOBS=               # filled by scripts/setup_notion_db.py
NOTION_DB_CONTACTS=           # filled by scripts/setup_notion_db.py
NOTION_PARENT_PAGE_ID=        # a Notion page where the DBs will be created (one-time)

# Discovery sources
# Indeed-only by default — free, no paid API. jobspy is the engine that scrapes
# Indeed. Leave these as-is unless you deliberately turn a paid source back on.
DISCOVERY_SOURCES=jobspy      # comma-separated: jobspy[,serpapi][,firecrawl]
JOBSPY_SITES=indeed           # comma-separated: indeed[,linkedin]. LinkedIn off by default.
SERPAPI_KEY=                  # https://serpapi.com  (out of credits — leave blank)
APIFY_TOKEN=                  # https://apify.com    (unused)
FIRECRAWL_API_KEY=            # https://firecrawl.dev (unused)

# Contact finder
APOLLO_API_KEY=               # https://apollo.io -> settings -> integrations -> API

# Email — pick ONE channel.
# Option A: Microsoft Graph (recommended, uses Paula's existing hotmail/outlook)
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=common
MS_GRAPH_REFRESH_TOKEN=
MS_GRAPH_USER_EMAIL=paulich98@hotmail.com

# Option B: Gmail API (dedicated job-search gmail)
# GMAIL_TOKEN_JSON= (paste the token.json contents as a single-line JSON string)

# Pipeline behavior
PIPELINE_TIMEZONE=Asia/Dubai
PIPELINE_DIGEST_TO=paulich98@hotmail.com
PIPELINE_MAX_RESULTS_PER_QUERY=30
PIPELINE_HOURS_OLD=48
PIPELINE_DRY_RUN=false
